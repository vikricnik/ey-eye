    {
      "name": "two-branches-one-target",
      "definition": {
        "name": "two",
        "defaults": {
          "model": {
            "provider": "ollama",
            "model": "m"
          }
        },
        "nodes": [
          {
            "id": "x",
            "prompt_template": "{{ input }}"
          },
          {
            "id": "y",
            "prompt_template": "{{ input }}"
          },
          {
            "id": "t",
            "prompt_template": "{{ input }}"
          },
          {
            "id": "u",
            "prompt_template": "{{ input }}"
          }
        ],
        "output_node": [
          "t",
          "u"
        ],
        "branches": [
          {
            "id": "bx",
            "from": "x",
            "routes": [
              {
                "when": "\"A\" in output",
                "to": "t"
              },
              {
                "default": true,
                "to": "u"
              }
            ]
          },
          {
            "id": "by",
            "from": "y",
            "routes": [
              {
                "when": "\"A\" in output",
