# === LLM Pipeline Configuration ===
# Copy this file to `.env` and adjust values for your local setup.

# --- Where pipeline YAML definitions live ---
# Relative paths resolve against the working directory the server is
# started from — use an absolute path in production deployments.
PIPELINES_DIR=pipelines

# --- Default pipeline (used only when a client omits pipeline_name;
# real clients should always send it explicitly) ---
DEFAULT_PIPELINE_NAME=simple-local

# --- Ollama connection ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Cloud provider API keys (only needed if a pipeline YAML references
# openai/anthropic/gemini models) ---
# Read automatically by their respective langchain packages, not by
# settings.py directly.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# --- CORS ---
# Comma-separated list of allowed origins for browser clients.
# Use "*" for local development only — tighten this in production.
CORS_ALLOWED_ORIGINS=*

# ============================================================
# --- Auth ---
# Comma-separated API keys. EMPTY BY DEFAULT — meaning /ask and /pipelines/*
# run with NO AUTHENTICATION. A startup warning is logged when this is
# empty. Set at least one key before exposing this server beyond localhost:
#
#   API_KEYS=change-me-to-a-real-random-value
#
# Clients then send either:
#   Authorization: Bearer change-me-to-a-real-random-value
#   X-API-Key: change-me-to-a-real-random-value
#
# /health is always open (no auth) — load balancers/orchestrators typically
# probe it without credentials.
API_KEYS=

# --- Rate limiting ---
# Requests per 60-second window, per API key (or per client IP if auth is
# disabled). Enforced per-process — see rate_limit.py's docstring for why
# this doesn't give a hard global cap across multiple server instances.
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Prompt/history safety ---
# Basic length caps on /ask's prompt and each conversation history turn.
MAX_PROMPT_LENGTH=8000
MAX_HISTORY_TURN_LENGTH=8000

# --- Startup validation ---
# Re-validates every pipelines/*.yaml file's SCHEMA at startup (does NOT
# call any real model — no cost/side effects). Logs which files failed, if
# any, so misconfiguration is visible immediately rather than on first request.
VALIDATE_PIPELINES_ON_STARTUP=true

# --- Circuit breaker ---
# After this many CONSECUTIVE failures for a given model, stop calling it
# for this many seconds (fail fast) before trying again.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# ============================================================

# NOTE: per-node model timeout, history window, and retry behavior
# (max_retries, retry_backoff_seconds) are defined PER PIPELINE, inside
# each YAML file's `execution:` block — not as global env vars, since
# different pipelines legitimately want different values (a 3-node
# consensus pipeline vs. a 4-node sequential review pipeline have
# different latency/cost budgets).
