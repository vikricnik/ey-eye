# === LLM Pipeline Configuration ===
# Copy this file to `.env` and adjust values for your local setup.
# .env is loaded by the FastAPI app only — it does NOT configure the
# Ollama server itself. See notes at the bottom for Ollama-specific vars.

# --- Generation tier: how generator models run ---
# "parallel"   -> all generator models run concurrently (needs enough RAM
#                 to hold all of them loaded at once)
# "sequential" -> generator models run one after another (lighter RAM footprint)
LLM_PIPELINE_MODE=parallel

# --- Generation collaboration (only valid when LLM_PIPELINE_MODE=sequential) ---
# "independent"   -> each generator produces its own answer from scratch
# "collaborative" -> each generator sees the prior answer(s) and refines them,
#                     like a relay/chain-of-improvement pipeline
LLM_GENERATION_COLLABORATION=independent

# --- Validation tier: how many validators check each answer ---
# "single"   -> one validator model checks each candidate (fast, cheap)
# "multiple" -> several validator models vote; result decided by quorum
LLM_VALIDATION_MODE=single

# Only relevant when LLM_VALIDATION_MODE=multiple
# Fraction of validators that must approve for a candidate to pass.
# 0.5 = simple majority, 1.0 = unanimous required
LLM_VALIDATION_QUORUM=0.5

# --- Validation concurrency (only relevant when LLM_VALIDATION_MODE=multiple) ---
# "sequential" -> validators run one at a time (lighter RAM)
# "parallel"   -> all validators run concurrently (faster, needs more
#                 models resident at once)
LLM_VALIDATION_CONCURRENCY=sequential

# --- Conversation history ---
# Maximum number of prior turns folded into the prompt as context.
# Set to 0 to disable history entirely (each request fully independent).
LLM_MAX_HISTORY_TURNS=6

# --- Per-model timeout ---
# Hard timeout (seconds) applied to every individual model call (router,
# each generator, each validator, judge). A model that hangs past this is
# treated as failed and isolated from the rest of the pipeline rather than
# blocking the whole request indefinitely.
LLM_MODEL_TIMEOUT_SECONDS=60

# --- Ollama connection ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Cloud provider API keys (only needed if you add cloud models to
# model_registry.py — see GENERATOR_SPECS/VALIDATOR_SPECS in that file) ---
# These are read automatically by their respective langchain packages;
# they are NOT read by settings.py directly.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# NOTE: which specific models run for which category (CODE/GENERAL/MATH/CREATIVE),
# and which provider each one uses, is configured in
# llm_pipeline/model_registry.py — not via environment variables. That's a
# structural, type-checked config (Python), not a simple toggle, so it lives in
# code rather than .env.

# --- CORS ---
# Comma-separated list of allowed origins for browser clients.
# Use "*" for local development only — tighten this in production.
CORS_ALLOWED_ORIGINS=*

# ============================================================
# NOTE: These are NOT read from this .env file — they must be
# set in the shell/environment BEFORE starting `ollama serve`,
# since they configure the Ollama server process, not this app.
#
#   OLLAMA_MAX_LOADED_MODELS=3   # pair with LLM_PIPELINE_MODE=parallel
#   OLLAMA_KEEP_ALIVE=30m
#
# On macOS, if Ollama runs as a background app/service rather
# than a manually-run `ollama serve`, use instead:
#   launchctl setenv OLLAMA_MAX_LOADED_MODELS 3
# then restart the Ollama app for it to take effect.
# ============================================================
