{
  "name": "llm-pipeline-web",
  "version": "1.0.0",
  "description": "Web client for the multi-tier LLM pipeline (FastAPI + LangGraph + Ollama)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@llm-pipeline/client": "^1.0.0",
    "@xyflow/react": "^12.11.6",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
